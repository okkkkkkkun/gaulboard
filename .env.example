# すべて任意です。空のままでも、カードの作成・保存・アーカイブ・PNG書き出しは動きます。
# このファイルを .env.local にコピーして使ってください。キーをクライアントへは出しません。

# OpenAI 互換のチャット API。設定すると「メモから下書き」が有効になります。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Notion。両方そろったときだけ「Notionへ送る」が有効になります。
NOTION_API_TOKEN=
NOTION_DATABASE_ID=

# SQLite ファイルの場所。未設定なら data/gaulboard.sqlite
GAULBOARD_DB=
